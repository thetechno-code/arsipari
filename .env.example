APP_NAME=ARSIPARI
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://arsipari.local

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/arsipari/database/database.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ARSIPARI Configuration Parameters
ARSIPARI_VERSION=1.0.0
ARSIPARI_BACKUP_RETENTION=7
ARSIPARI_PDF_MAX_ROWS=5000
ARSIPARI_RETENTION_WARNING_DAYS=90
ARSIPARI_MAX_FILE_SIZE_MB=20
